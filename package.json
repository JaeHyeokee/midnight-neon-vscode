{
    "name": "midnight-neon-vscode",
    "displayName": "Midnight Neon",
    "description": "A Synthwave-inspired colour theme to satisfy your neon dreams",
    "version": "0.1.0",
    "author": "JaeHyeokee",
    "publisher": "JaeHyeokee",
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/JaeHyeokee/midnight-neon-vscode"
    },
    "engines": {
        "vscode": "^1.33.0"
    },
    "extensionKind": [
        "ui"
    ],
    "keywords": [
        "retro",
        "80s",
        "synthwave",
        "cyberpunk",
        "neon",
        "dark"
    ],
    "categories": [
        "Themes"
    ],
    "activationEvents": [
        "onCommand:midnightNeon.enableNeon",
        "onCommand:midnightNeon.disableNeon"
    ],
    "main": "./src/extension.js",
    "contributes": {
        "themes": [
            {
                "label": "Midnight Neon",
                "uiTheme": "vs-dark",
                "path": "./themes/synthwave-color-theme.json"
            }
        ],
        "commands": [
            {
                "command": "midnightNeon.enableNeon",
                "title": "Midnight Neon : Enable Neon Dreams"
            },
            {
                "command": "midnightNeon.disableNeon",
                "title": "Midnight Neon : Disable Neon Dreams"
            }
        ],
        "configuration": {
            "title": "Midnight Neon",
            "properties": {
                "midnightNeon.brightness": {
                    "type": "number",
                    "default": 0.45,
                    "description": "Set the brightness value for the glow effect. 0.0 is fully transparent and 1.0 is fully bright"
                },
                "midnightNeon.disableGlow": {
                    "type": "boolean",
                    "default": false,
                    "description": "Disable the glow effect, but show Midnight Neon editor chrome updates"
                }
            }
        }
    }
}
